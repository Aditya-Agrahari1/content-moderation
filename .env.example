# Copy to .env to override defaults. docker-compose.yml has working local defaults,
# so `docker compose up` works without this file.

# Shared HMAC secret for provider callbacks. Placeholder only - set a real random
# value in any non-local environment. The API logs a warning while the placeholder is used.
PROVIDER_CALLBACK_SECRET=local-dev-placeholder-not-secret

# Provider client timeouts (seconds)
PROVIDER_CONNECT_TIMEOUT_S=2
PROVIDER_READ_TIMEOUT_S=10

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_S=2
MAX_CONCURRENT_PER_WORKSPACE=4
LEASE_DURATION_S=30
LEASE_HEARTBEAT_S=5

# Retry budgets (per recovery cycle unless noted)
MAX_FAILURES_PER_CYCLE=4
MAX_RATE_LIMITED_PER_CYCLE=10
MAX_MALFORMED_TOTAL=3
BACKOFF_BASE_S=1
BACKOFF_CAP_S=8
RETRY_AFTER_DEFAULT_S=10
RETRY_AFTER_MAX_S=60

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_S=10
CB_COOLDOWN_MAX_S=60

# Sweeper
SWEEP_INTERVAL_S=2
HELD_PROVIDER_MIN_WAIT_S=30
CALLBACK_DEADLINE_S=60

# Input limits
MAX_FRAME_COUNT=3600
MAX_BODY_BYTES=1048576

# Fake provider
ASYNC_FRAME_THRESHOLD=30
PROVIDER_HANG_S=60
CALLBACK_DELAY_MS=500
CALLBACK_MAX_ATTEMPTS=5
